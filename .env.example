# ============================================================
# StudyNest AI Study Assistant Configuration
# ============================================================
# To connect real-time AI to StudyNest:
# 1. Create a copy of this file named ".env" in this directory:
#    copy .env.example .env
# 2. Add your Google Gemini API key or OpenAI API key below.
# 3. Restart the dev server (npm.cmd run dev).
# ============================================================

# Option 1: Google Gemini API (Recommended - Free & Fast)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Option 2: OpenAI or OpenAI-Compatible API (Optional)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Default AI Provider ('gemini' or 'openai')
AI_PROVIDER=gemini

