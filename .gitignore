# ============================================================
# StudyNest .gitignore — Production & GitHub Security
# ============================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Production Build Outputs
dist/
dist-ssr/
build/
*.tsbuildinfo

# Environment Variables & Secrets (NEVER commit to GitHub)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
!.env.example

# Private Credentials & Certificates
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa
id_dsa
id_ecdsa
id_ed25519
credentials.json
service-account*.json

# Vercel Deployment Metadata
.vercel

# Debug & Execution Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Specific
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace
